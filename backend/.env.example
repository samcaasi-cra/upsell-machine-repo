# SecurityScorecard API key -- required for live score lookups.
API_KEY=your_securityscorecard_api_key_here

# OpenAI API key -- optional. Only needed for the "Auto-research" buttons
# (web search + scrape + summarise). Without it, the copy/paste prompt flow
# still works for both decision-maker and news research.
OPENAI_API_KEY=

# Shared team password -- REQUIRED for any deployed instance, since the dashboard
# shows real customer data. Leave blank locally to skip the login screen.
APP_PASSWORD=

# Optional: separate signing secret for session tokens. Defaults to APP_PASSWORD.
# Changing it invalidates all existing sessions immediately.
APP_SECRET=

# Comma-separated extra CORS origins (the deployed frontend URL). localhost is
# always allowed, so this is only needed when deployed.
ALLOWED_ORIGINS=

# Cyber Rescue's account tracker ("Our accounts", internal view). Optional -- without
# these, it reads backend/private/cr_tracker.xlsx (or CR_TRACKER_PATH) instead.
#
# Set CR_TRACKER_SHEET_ID to read the live Google Sheet over the Sheets API instead of
# a local export, refreshed every 5 minutes. Needs a Google Cloud service account with
# the Sheets API enabled and Viewer access on the sheet itself:
#   1. console.cloud.google.com -> a project -> enable the "Google Sheets API"
#   2. IAM & Admin -> Service Accounts -> Create -> no roles needed (sheet access is
#      granted by sharing the sheet, not by IAM)
#   3. that service account -> Keys -> Add key -> JSON -> download it
#   4. share the Google Sheet itself with the service account's email (ends in
#      @<project>.iam.gserviceaccount.com) as Viewer
#   5. put the downloaded key at backend/private/ (gitignored) and point
#      GOOGLE_APPLICATION_CREDENTIALS at it, OR paste its contents into
#      CR_TRACKER_GOOGLE_CREDENTIALS_JSON directly (handier for a deployed env var)
CR_TRACKER_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
CR_TRACKER_GOOGLE_CREDENTIALS_JSON=
